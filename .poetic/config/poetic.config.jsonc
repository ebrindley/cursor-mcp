{
  "$schema": "https://raw.githubusercontent.com/ebrindley/poetic/main/schemas/poetic.config.schema.json",

  // No project-level defaultProvider override: Poetic resolves the default
  // from environment, user config, profiles, and the bundled provider registry.

  // AI provider configuration: providers are peers. Enable or disable entries
  // for this project without choosing a universal default here.
  "providers": {
    "claude": {
      "enabled": true
      // "model": "..." // optional — omit to use provider defaults
    },
    "codex": {
      "enabled": true
      // "model": "..." // optional — omit to use provider defaults
    },
    "cursor": {
      "enabled": true,
      "model": "auto" // Cursor auto-selects model
    },
  },

  // Quality gates: automated validation for generated work where project
  // capabilities or explicit verification config provide commands.
  "quality": {
    "coverage": {
      "enabled": true,
      "threshold": 80, // Minimum test coverage percentage
    },
    "lint": {
      "enabled": true,
      // Uses the target project's configured lint command when available.
    },
    "security": {
      "enabled": true,
      // Uses a dependency-audit command only when the target project supports one.
    },
  },

  // Telemetry Configuration — variant performance tracking (all data stored locally)
  "telemetry": {
    "enabled": true,
    "database": ".poetic/telemetry/db/variants.db",
    // All telemetry stored locally — no data sent externally
  },

  // Variant Competition Settings — how competing variants are evaluated
  "variants": {
    "strategies": {
      "conservative": { "weight": 0.4 }, // Stability-focused
      "innovative": { "weight": 0.3 },   // Cutting-edge approaches
      "hybrid": { "weight": 0.3 },        // Balanced pragmatism
    },
    // Maximum concurrent variant executions
    "maxConcurrent": 3,
  },

  // Execution Settings — timeout, concurrency, and merge-time repair
  "execution": {
    // Default timeout for variant competition (minutes)
    "defaultTimeout": 30,
    // CPU-aware concurrency (cores × multiplier, max 5)
    "concurrencyMultiplier": 2,

    // Merge-time repair uses runtime defaults unless explicitly configured.
    // Override via config or env: POETIC_BIOME_REPAIR_PROVIDER / POETIC_BIOME_REPAIR_MODEL
  },
}
